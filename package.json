{
  "name": "tally-mcp",
  "version": "0.4.0",
  "description": "Read-only MCP server exposing TallyPrime accounting data to Claude Desktop",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "tally-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "mock-tally": "tsx mock-tally/server.ts",
    "probe:reports": "tsx scripts/probe-reports.ts",
    "probe:period": "tsx scripts/probe-statement-period.ts",
    "probe:empty": "tsx scripts/probe-empty-reports.ts",
    "probe:todate": "tsx scripts/probe-todate-binding.ts",
    "check:live": "node scripts/live-check.mjs",
    "check:live4": "node scripts/live-check-v4.mjs",
    "check:build": "node installer/scripts/lib/buildFreshness.mjs",
    "verify": "npm run typecheck && npm run lint && npm test",
    "preversion": "npm run verify && npm run check:build",
    "version": "node scripts/stamp-changelog.mjs && git add CHANGELOG.md",
    "postversion": "node -e \"console.log('\\nTagged v' + process.env.npm_package_version + '. Push it with:  git push --follow-tags\\nThen build a release with:  powershell -ExecutionPolicy Bypass -File installer\\\\package.ps1\\n')\"",
    "verify:ship": "npm run verify && npm run check:build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
