      <ISDEEMEDPOSITIVE>Yes</ISDEEMEDPOSITIVE>
      <AMOUNT>-60000.00</AMOUNT>
     </ALLLEDGERENTRIES.LIST>
     <ALLLEDGERENTRIES.LIST>
      <LEDGERNAME>HDFC Bank Current A/c</LEDGERNAME>
      <ISDEEMEDPOSITIVE>No</ISDEEMEDPOSITIVE>
      <AMOUNT>60000.00</AMOUNT>
      <BANKALLOCATIONS.LIST>
       <DATE>20260705</DATE>
       <INSTRUMENTDATE>20260705</INSTRUMENTDATE>
       <INSTRUMENTNUMBER>100234</INSTRUMENTNUMBER>
       <!-- Populated: this entry has been reconciled against the statement. -->
       <BANKERSDATE>20260712</BANKERSDATE>
       <TRANSACTIONTYPE>Cheque</TRANSACTIONTYPE>
       <PAYMENTFAVOURING>Bramley &amp; Sons Accessories Private Limited</PAYMENTFAVOURING>
       <CHEQUECROSSCOMMENT>A/c Payee</CHEQUECROSSCOMMENT>
