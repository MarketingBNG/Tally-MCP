     </ALLLEDGERENTRIES.LIST>
    </VOUCHER>
   </TALLYMESSAGE>
   <TALLYMESSAGE xmlns:UDF="TallyUDF">
    <VOUCHER VCHTYPE="Payment" ACTION="Create">
     <DATE>20260720</DATE>
     <GUID>bbbb-0002</GUID>
     <VOUCHERTYPENAME>Payment</VOUCHERTYPENAME>
     <VOUCHERNUMBER>P-21</VOUCHERNUMBER>
     <PARTYLEDGERNAME>Bramley &amp; Sons Accessories Private Limited</PARTYLEDGERNAME>
