<!-- A real TallyPrime response for a company with NO inventory. Captured
     shape: header plus CMPINFO counters only, with no <DATA> section at all.
     The <STOCKITEM>0</STOCKITEM> here is a record COUNTER, not an item, and a
     document-wide tag search would report it as a phantom stock item. -->
<ENVELOPE>
 <HEADER>
  <VERSION>1</VERSION>
  <STATUS>1</STATUS>
 </HEADER>
 <BODY>
  <DESC>
   <CMPINFO>
    <COMPANY>0</COMPANY>
    <GROUP>0</GROUP>
    <LEDGER>0</LEDGER>
    <STOCKGROUP>0</STOCKGROUP>
    <STOCKCATEGORY>0</STOCKCATEGORY>
    <STOCKITEM>0</STOCKITEM>
    <VOUCHERTYPE>0</VOUCHERTYPE>
    <UNIT>0</UNIT>
   </CMPINFO>
  </DESC>
 </BODY>
</ENVELOPE>
