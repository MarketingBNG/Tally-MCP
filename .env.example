# TallyPrime connection settings.
#
# IMPORTANT: this file is a DEVELOPMENT convenience only.
# Claude Desktop launches this server with its own `env` block in
# claude_desktop_config.json and will NOT read this file. When running under
# Claude Desktop, the values in that config are what actually apply.
# See README.md → "Configuration".

# Host running TallyPrime. Tally's HTTP server listens locally.
TALLY_HOST=127.0.0.1

# Port configured in TallyPrime (F1 > Settings > Connectivity > Client/Server
# configuration > TallyPrime acts as "Both" or "Server", Port = 9000).
TALLY_PORT=9000

# http or https. Tally's built-in server is plain HTTP.
TALLY_PROTOCOL=http

# Per-request timeout in milliseconds for ordinary requests.
# Report-class requests (trial balance, P&L, balance sheet) use a longer
# timeout internally — see TALLY_REPORT_TIMEOUT_MS.
TALLY_TIMEOUT_MS=30000

# Timeout for inherently large report requests. Defaults to 4x TALLY_TIMEOUT_MS
# if unset. See PROJECT_SPEC.md → "Pagination".
# TALLY_REPORT_TIMEOUT_MS=120000

# Preferred wire format: json | xml
# Native JSON requires TallyPrime 7.0 or later. On older builds the server
# falls back to XML per-request automatically.
TALLY_PREFERRED_FORMAT=json

# Maximum records the server will hold in memory for one query before
# returning RESULT_LIMIT_EXCEEDED instead of attempting the fetch.
TALLY_MAX_RECORDS=5000

# Maximum serialised size of a single tool response, in bytes. Exceeding it
# returns RESPONSE_TOO_LARGE naming a pageSize that fits, rather than sending
# the client something it will silently discard.
#
# The default is set by CONTEXT budget, not by the client's 1MB message cap —
# those are different things. At the old 900000, one legal response was roughly
# 225,000 tokens and could consume a fifth of a conversation on its own.
# 150000 is about 37,500 tokens. Raise it deliberately for a one-off deep dive.
TALLY_MAX_RESPONSE_BYTES=150000

# How long, in milliseconds, an identical request to Tally — and the records
# parsed from it — are served from memory instead of being fetched again.
#
# This is the single biggest lever on how long an audit takes. One period's
# voucher register is 21MB and takes TallyPrime about 7 seconds; bank
# reconciliation, outstanding, GST, inventory movements and the voucher list all
# read it. The old 20000 was shorter than a person thinks for, so the cache
# lapsed between questions and each lapse cost the full 7 seconds again.
#
# Measured on a 9-question audit with 25s of thinking between questions:
# 64s of waiting at 20000, 12s at 300000 — an 81% cut.
#
# The trade-off: a change made in TallyPrime WHILE a conversation is running may
# not be seen for up to 5 minutes. This server cannot write, so the only way to
# hit that is to edit the books by hand mid-audit. Lower it if that matters for
# a session; 0 disables caching entirely.
TALLY_CACHE_TTL_MS=300000

# error | warn | info | debug
# All logs go to stderr — stdout is reserved for the MCP protocol.
LOG_LEVEL=info
